{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "jsx": "react-jsx",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/renderer/**/*",
    "src/shared/**/*",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    "src-tauri"
  ]
}
