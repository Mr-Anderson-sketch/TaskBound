{
  "name": "timebound",
  "version": "2.0.0-alpha.0",
  "description": "Keeps your current task in front of you in a 32 px strip at the edge of the screen. Local-first, keyboard-first, Windows 11 and macOS.",
  "author": "Bloomeasy",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main/main/main.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development concurrently -k \"npm:dev:main\" \"npm:dev:preload\" \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:preload": "tsc -p tsconfig.preload.json --watch",
    "dev:renderer": "vite dev --host --port 5173",
    "dev:electron": "wait-on dist/main/main/main.js dist/preload/main/preload.js http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 ELECTRON_RUN_AS_NODE= electron .",
    "build": "rimraf dist && tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json",
    "test": "cross-env TZ=America/New_York vitest run && cross-env TZ=Asia/Kolkata vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test e2e/smoke.spec.ts",
    "theme:build": "node scripts/build-theme-css.mjs",
    "theme:check": "node scripts/check-contrast.mjs",
    "package": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "productName": "TimeBound",
    "appId": "com.timebound.app",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "build/icon-16x16.png", "to": "icons/icon-16x16.png" },
      { "from": "build/icon-32x32.png", "to": "icons/icon-32x32.png" }
    ],
    "extraMetadata": {
      "main": "dist/main/main/main.js"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signingHashAlgorithms": [
        "sha256"
      ],
      "signDlls": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@tanstack/react-virtual": "^3.13.0",
    "date-fns": "^4.1.0",
    "immer": "^10.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.0"
  },
  "optionalDependencies": {
    "koffi": "^2.10.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^44.3.0",
    "electron-builder": "^26.0.0",
    "fast-check": "^3.23.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^3.0.0",
    "wait-on": "^8.0.1"
  }
}
